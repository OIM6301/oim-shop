# Settings for oim-shop. Every one is optional; the values shown are the defaults.
# To use a file of your own: cp .env.example .env, edit it, then
#   uv run --project api --env-file .env oim-shop serve
# .env is ignored by git. v2 has no secrets; v3 adds the first ones here.

# The SQLite database, created and loaded from data/seed on first start.
OIM_SHOP_DB=oim-shop.db

# The seed data and the built web app.
# OIM_SHOP_SEED=data/seed
# OIM_SHOP_WEB=web/dist

# A fixed moment, Boston time, used instead of the clock (for tests and screenshots).
# OIM_SHOP_NOW=2026-10-22T17:00:00

# Changes each signed-in person may make in a minute.
# OIM_SHOP_WRITES_PER_MINUTE=30

# Signing in (v3). Without the first three, no one can sign in and the app is read-only.
# Create your own GitHub OAuth App with the callback http://127.0.0.1:8000/api/auth/callback
OIM_SHOP_GITHUB_CLIENT_ID=
OIM_SHOP_GITHUB_CLIENT_SECRET=
# A file of the GitHub usernames who may sign in, one per line; add "manager" after a name for a manager
OIM_SHOP_ALLOWED_USERS=
# Where browsers reach the app; on the Vite dev server, http://127.0.0.1:5173
OIM_SHOP_PUBLIC_URL=http://127.0.0.1:8000
